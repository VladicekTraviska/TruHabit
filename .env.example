# Documentation template only. The binary reads process environment, not .env files.
# Local Windows: scripts/run-local.ps1 supplies protected local database credentials.
# Production values below must be provided by a secret manager/deployment service.
APP_ENV=production
SITE_ORIGIN=https://app.example.com
BIND_ADDR=127.0.0.1:8787
DIST_DIR=web/dist
DATABASE_URL=postgres://truhabit_app:REPLACE@database.example.com/truhabit?sslmode=verify-full
# Optional exact socket peer IP of the one trusted reverse proxy.
# The proxy must overwrite X-Real-IP and preserve Host. Never trust arbitrary clients.
TRUSTED_PROXY_IP=127.0.0.1
SMTP_HOST=smtp.example.com
SMTP_USERNAME=REPLACE
SMTP_PASSWORD=REPLACE
MAIL_FROM=TruHabit <support@example.com>
# Generate an independent cryptographically random 32-byte key, encoded as 64 hex characters.
MAIL_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
